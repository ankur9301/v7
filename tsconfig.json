{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "env.d.ts",
    
  ]
}


